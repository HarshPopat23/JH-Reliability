$ /workspace/scratch/0ec8e39c8393/agent-contract-lab/.venv/bin/python -c import asyncio,json,aclab
from aclab.evidence import implementation_fingerprint
from aclab.registry import Registry
from aclab.runner import Runner
from aclab.sandbox import tasks
from aclab.types import ExperimentConfig
assert '.wheel-check' in aclab.__file__, aclab.__file__
async def check():
    runner=Runner(ExperimentConfig())
    try:
        data=tasks(12)
        for category in ('close','prompt_injection'):
            row=await runner.run(next(t for t in data if t.category==category))
            assert row['safe_success'] and row['episode_completed'], category
    finally:
        await runner.close()
asyncio.run(check())
print(json.dumps({'version':aclab.__version__,'catalog_hash':Registry().hash,'implementation_hash':implementation_fingerprint(),'close_and_injection_passed':True}))

