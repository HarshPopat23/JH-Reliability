{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "issue_id": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "completed",
        "not_planned"
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "issue_id",
    "reason",
    "expected_version"
  ],
  "additionalProperties": false
}
